# Supabase (Backend, Auth, PostgreSQL, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Nouvelle clé publiable Supabase (sb_publishable_...) — recommandée (remplace l'ancienne clé anon JWT retirée en 2027)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key
# Clé secrète serveur uniquement (sb_secret_...) — NE JAMAIS préfixer avec NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key

# Domaine principal SaaS (utilisé par le middleware multi-tenant)
NEXT_PUBLIC_ROOT_DOMAIN=ecomsate.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

